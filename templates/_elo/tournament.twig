{% extends "_elo/_layout.twig" %}

{# One tournament's draws, draw luck and, once played, how the predictions turned out
   (elo/data/upcoming/<Cup2000 id>.json, from elo/upcoming.mjs). `tournamentId` (the Cup2000 id)
   comes from the route; ?event=<index> picks the event shown. #}

{% set t = craft.elo.tournament(tournamentId) %}
{% if not t %}{% exit 404 %}{% endif %}
{% set clubEntries = craft.entries.section('clubs').with(['clubLogo']).collect().keyBy('title') %}
{% set eventIndex = craft.app.request.getQueryParam('event')|default(0) %}
{% set eventIndex = eventIndex matches '/^\\d+$/' and t.events[eventIndex + 0] is defined ? eventIndex + 0 : 0 %}
{% set event = t.events[eventIndex] %}
{% set view = craft.app.request.getQueryParam('view') == 'summary' ? 'summary' : 'events' %}
{# Every entry with its event, for the tournament-wide lists: luck (events with a single group
   have none) and the winners of played events #}
{% set all = [] %}
{% for e in t.events %}
  {% for entry in e.entries %}
    {% set all = all|merge([entry|merge({ eventIndex: loop.parent.loop.index0, eventLabel: e.className ~ ' ' ~ e.poolLabel|lower, placement: e.placement ?? false, singleGroup: e.singleGroup ?? false })]) %}
  {% endfor %}
{% endfor %}
{# Luck in each event's own measure: places in events that place everyone (the X classes), else rounds #}
{% set withLuck = all|filter(e => e.luck is not null) %}
{% set byLuck = withLuck|sort((a, b) => (b.luck.score ?? b.luck.progress) <=> (a.luck.score ?? a.luck.progress)) %}
{% set champions = all|filter(e => (e.result.win ?? 0) == 1)|sort((a, b) => a.actual.win <=> b.actual.win) %}
{% set ev = t.evaluation ?? null %}

{% macro pct(x) %}{% set p = (x * 100)|round %}{{ (x > 0 and p < 1 ? '<1%' : (x < 1 and p > 99 ? '>99%' : p ~ '%'))|e }}{% endmacro %}
{% macro signed(x, decimals = 2) %}{{ x > 0 ? '+' : (x < 0 ? '−' : '±') }}{{ x|abs|number_format(decimals) }}{% endmacro %}
{# A placement: 1, 2, 3–4 (shared, 3.5), 5, ... #}
{% macro place(p) %}{{ p == p|round ? p|round : (p - 0.5)|round ~ '–' ~ (p + 0.5)|round }}{% endmacro %}

{# An entry's players with their club logos and ratings; ≈ marks a rating estimated for someone without one in this discipline #}
{% macro entry(e, clubEntries) %}
  {% for p in e.players %}
    {%- set club = p.club ? (clubEntries[p.club] ?? null) : null -%}
    {%- set logo = club ? club.clubLogo|first : null -%}
    <span class="flex items-center gap-1.5">
      {%- if logo %}<img src="{{ logo.url }}" alt="" class="w-4 h-4 object-contain shrink-0">{% endif -%}
      {% if p.id %}<a href="{{ url('elo/players/' ~ p.id) }}" class="hover:text-blue-600">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}
      <span class="text-sm text-gray-500 tabular-nums" {% if p.estimated %}title="No rating in this discipline: estimated"{% endif %}>{{ p.estimated ? '≈' : '' }}{{ p.rating|round }}</span>
    </span>
    {% if p.club %}<span class="block text-sm text-gray-600 {{ logo ? 'pl-5.5' : '' }}">{{ p.club }}</span>{% endif %}
  {% endfor %}
{% endmacro %}

{% block content %}
  {% import _self as m %}
  <section class="base-section">
    <div class="base-container px-4">
      <a href="{{ url('elo/tournaments') }}" class="text-gray-600 hover:text-black">&larr; Tournaments</a>
      <h1 class="h1 mt-4">{{ t.name }}</h1>
      {% if t.startDate %}
        <p class="text-2xl text-gray-700">{{ t.startDate|date('j') }}{{ t.endDate and t.endDate != t.startDate ? '–' ~ t.endDate|date('j F Y') : ' ' ~ t.startDate|date('F Y') }}</p>
      {% endif %}
      <p class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
        <a href="https://www.cup2000.dk/turnerings-system/Vis-turneringer/?tournamentid={{ t.cup2000Id }}" class="underline hover:text-blue-600" rel="noopener">Draw and results on Cup2000</a>
        {% if t.portalenId %}<span class="text-gray-600">badmintonportalen tournament {{ t.portalenId }}</span>{% endif %}
      </p>
      {# Two views: the event tables (default) and the tournament's summary #}
      <nav class="flex gap-2 mt-6" aria-label="Views">
        {% for key, label in { events: 'Events', summary: 'Summary' } %}
          <a href="{{ url('elo/tournaments/' ~ t.cup2000Id, key == 'summary' ? { view: 'summary' } : {}) }}"
             class="px-4 py-2 border border-black transition-colors duration-200 {{ view == key ? 'bg-black text-white' : 'hover:bg-black hover:text-white' }}"
             {% if view == key %}aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
    </div>
  </section>

  {% if view == 'summary' %}
    {# How the predictions turned out, once events are played #}
    {% if ev and ev.events %}
      {% set slope = ev.luck.rounds.xx > 0 ? ev.luck.rounds.xy / ev.luck.rounds.xx : null %}
      <section class="base-section">
        <div class="base-container px-4">
          <h2 class="text-3xl mb-4">How the predictions turned out</h2>
          <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            <div class="bg-white p-4">
              <dt class="text-sm text-gray-600">Favourites who won</dt>
              <dd class="text-3xl font-semibold tabular-nums">{{ ev.favouritesWon }} <span class="text-base font-normal text-gray-500">of {{ ev.winners }}</span></dd>
              <dd class="text-sm text-gray-600">{{ ev.favouritesExpected|number_format(1) }} expected</dd>
            </div>
            <div class="bg-white p-4">
              <dt class="text-sm text-gray-600">Winners' predicted chance</dt>
              <dd class="text-3xl font-semibold tabular-nums">{{ m.pct(ev.winnerChance / ev.winners) }}</dd>
              <dd class="text-sm text-gray-600">on average</dd>
            </div>
            <div class="bg-white p-4">
              <dt class="text-sm text-gray-600">Events played</dt>
              <dd class="text-3xl font-semibold tabular-nums">{{ ev.events }} <span class="text-base font-normal text-gray-500">of {{ t.events|length }}</span></dd>
            </div>
            {% if slope is not null %}
              <div class="bg-white p-4">
                <dt class="text-sm text-gray-600" title="Results minus the fair-draw expectation against luck, regression slope">Luck showed in the results</dt>
                <dd class="text-3xl font-semibold tabular-nums">{{ slope|number_format(2) }}×</dd>
                <dd class="text-sm text-gray-600">over {{ ev.luck.rounds.n }} entries (1 = as predicted)</dd>
              </div>
            {% endif %}
          </dl>
          <p class="text-gray-700 max-w-3xl">
            The favourite is the entry with the best chance of winning the event with the actual draw.
            "Luck showed in the results": each entry's rounds minus its fair-draw expectation, against its luck (a regression through zero).
            Near 1, a draw rated a round luckier gave about a round more; near 0, the luck didn't show.
          </p>
        </div>
      </section>
    {% endif %}

    {# Surprising winners, luckiest and unluckiest draws: one box, one tab each #}
    {% set lists = [] %}
    {% if champions is not empty %}{% set lists = lists|merge([{ key: 'surprises', title: 'Most surprising winners', entries: champions|slice(0, 8), kind: 'winner' }]) %}{% endif %}
    {% if byLuck is not empty %}
      {% set lists = lists|merge([
        { key: 'luckiest', title: 'Luckiest draws', entries: byLuck|slice(0, 8), kind: 'luck' },
        { key: 'unluckiest', title: 'Unluckiest draws', entries: byLuck|reverse|slice(0, 8), kind: 'luck' },
      ]) %}
    {% endif %}
    {% if lists is not empty %}
      <section class="base-section">
        <div class="base-container px-4">
          <div class="bg-white p-4 md:p-6" data-controller="tabs" data-tabs-hash-value="false">
            <div role="tablist" aria-label="Lists" class="flex flex-wrap gap-2 mb-6">
              {% for list in lists %}
                <button type="button" role="tab" id="tab-{{ list.key }}" aria-controls="{{ list.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? 0 : -1 }}"
                        data-tabs-target="tab" data-action="tabs#choose keydown->tabs#key"
                        class="px-4 py-2 border border-black transition-colors duration-200 hover:bg-black hover:text-white aria-selected:bg-black aria-selected:text-white cursor-pointer">{{ list.title }}</button>
              {% endfor %}
            </div>
            {% for list in lists %}
              <div id="{{ list.key }}" role="tabpanel" aria-labelledby="tab-{{ list.key }}" data-tabs-target="panel" {% if not loop.first %}hidden{% endif %}>
                <ol class="grid gap-x-8 gap-y-4 md:grid-cols-2">
                  {% for e in list.entries %}
                    <li class="flex justify-between gap-4">
                      <div>
                        {{ m.entry(e, clubEntries) }}
                        <a href="{{ url('elo/tournaments/' ~ t.cup2000Id, { event: e.eventIndex }) }}" class="block text-sm text-gray-600 hover:text-blue-600">{{ e.eventLabel }}{% if list.kind == 'luck' and e.group %} · group {{ e.group }}{% endif %}</a>
                      </div>
                      <div class="text-right tabular-nums whitespace-nowrap">
                        {% if list.kind == 'winner' %}
                          <span class="text-xl font-semibold">{{ m.pct(e.actual.win) }}</span>
                          <span class="block text-sm text-gray-600">chance before</span>
                        {% else %}
                          {% set score = e.luck.score ?? e.luck.progress %}
                          <span class="text-xl font-semibold {{ score >= 0 ? 'text-green-700' : 'text-red-700' }}">{{ m.signed(score) }}</span>
                          <span class="block text-sm text-gray-600">{{ e.placement ? 'places' : 'rounds' }}</span>
                        {% endif %}
                      </div>
                    </li>
                  {% endfor %}
                </ol>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {# How it works: only what this tournament's events need (rounds for knockouts, places for X
       classes, which only Ranking/RT* tournaments have, and single groups) #}
    {% set hasRounds = t.events|filter(e => not (e.singleGroup ?? false) and not (e.placement ?? false))|length > 0 %}
    {% set hasPlacement = t.events|filter(e => e.placement ?? false)|length > 0 %}
    {% set hasSingle = t.events|filter(e => e.singleGroup ?? false)|length > 0 %}
    <section class="base-section">
      <div class="base-container px-4">
        <h2 class="text-3xl mb-4">How it works</h2>
        <div class="max-w-3xl text-gray-700 space-y-2">
          <p>
            How lucky each player's draw is, from their ratings at the end of the week before the tournament. Every event is played out {{ t.runs|number }} times with each match decided by the players' win chances,
            once with the actual draw and once with a fair draw: the same players drawn again at random, with the seeds (the strongest by rating: one per group, or 2–8 in a knockout) kept where they are.
          </p>
          <p>
            {% if hasRounds %}
              <strong class="font-semibold">Rounds</strong> is how far a player is expected to get: one round for getting out of the group and one for every knockout round after that (a bye counts too), and one more for winning.
              <strong class="font-semibold">Luck</strong> is the rounds expected with the actual draw minus with a fair one.
            {% endif %}
            {% if hasPlacement %}
              In the X classes everyone gets a final place, so luck there is in places: eight players or pairs in two groups of four, the top two to cross-over semi-finals, the third-placed playing for 5th and the fourth-placed for 7th.
            {% endif %}
            {% if hasSingle %}
              Events with a single group have no luck, as everyone plays everyone: they only show each player's chance of winning.
            {% endif %}
          </p>
        </div>
      </div>
    </section>
  {% else %}
  <section class="base-section">
    <div class="base-container px-4">
      {# Events by class (seniors and veterans, then juniors from the oldest; levels X, E, A, B, C, D), each in
         the order men's singles, women's singles, men's, women's and mixed doubles #}
      {% set disciplineOrder = ['men', 'women', 'mensDoubles', 'womensDoubles', 'mixedDoubles'] %}
      {# Levels within an age group: X (grand prix: the 6 highest ranked plus 2 wildcards, seniors
         and juniors alike), E (elite), A, B, C, D #}
      {% set levelOrder = { X: 0, E: 1, A: 2, B: 3, C: 4, D: 5 } %}
      {% set classes = t.events|map(e => e.className)|unique|values
        |map(name => { name: name, key: (name|split(' ')|first matches '/^U\\d+$/' ? 'b' ~ (100 + 100 - (name|split(' ')|first|slice(1))) : 'a' ~ (name|split(' ')|first)) ~ ' ' ~ (levelOrder[name|split(' ')|last] ?? 9) ~ (name|split(' ')|last) })
        |sort((a, b) => a.key <=> b.key)|map(c => c.name) %}
      <nav class="grid gap-3 mb-8" aria-label="Events">
        {% for className in classes %}
          <div class="flex flex-wrap items-center gap-2">
            <span class="w-20 shrink-0 font-semibold">{{ className }}</span>
            {% set classEvents = [] %}
            {% for i, e in t.events %}{% if e.className == className %}{% set classEvents = classEvents|merge([{ i: i, e: e }]) %}{% endif %}{% endfor %}
            {% for item in classEvents|sort((a, b) => (disciplineOrder|indexOf(a.e.pool)) <=> (disciplineOrder|indexOf(b.e.pool))) %}
              <a href="{{ url('elo/tournaments/' ~ t.cup2000Id, { event: item.i }) }}"
                 class="px-3 py-1 border border-black transition-colors duration-200 {{ item.i == eventIndex ? 'bg-black text-white' : 'hover:bg-black hover:text-white' }}"
                 {% if item.i == eventIndex %}aria-current="page"{% endif %}>{{ item.e.poolLabel }}</a>
            {% endfor %}
          </div>
        {% endfor %}
      </nav>

      {% set single = event.singleGroup ?? false %}
      {% set placement = event.placement ?? false %}
      {% set played = event.played ?? false %}
      <h2 class="text-3xl mb-1">{{ event.className }} {{ event.poolLabel|lower }}</h2>
      <p class="text-gray-700 mb-4">
        {{ event.entries|length }} {{ event.pool in ['men', 'women'] ? 'players' : 'pairs' }}
        {%- set ranks = event.advance.ranks ?? [1] %}
        {%- set best = event.advance.best ?? [] %}
        {%- set placeNames = { 1: 'winner', 2: 'runner-up', 3: 'third', 4: 'fourth' } %}
        {%- set numbers = { 2: 'two', 3: 'three', 4: 'four' } %}
        {%- set advanceText = ((ranks == [1] and best is empty) ? 'only ' : '')
          ~ (ranks == [1] ? 'the group winners' : 'the top ' ~ (numbers[ranks|length] ?? ranks|length) ~ ' of each group')
          ~ (best is not empty ? ' and the best ' ~ best|map(r => placeNames[r] ?? (r ~ '. place'))|join(' and ') ~ ' of all groups' : '')
          ~ ' go to the knockout' %}
        {%- set others = (event.stages ?? [])|filter(s => not s.main and not s.places)|length %}
        {%- if event.groups is not empty %} in {{ event.groups|length }} {{ event.groups|length == 1 ? 'group' : 'groups' }}{% if event.knockout %}; {{ advanceText }}{% if others and not placement %}, the rest to {{ others == 1 ? 'a B play-off' : others ~ ' further play-offs' }}{% endif %}{% endif %}{% elseif event.knockout %}, knockout{% endif %}.
        {% if single %}Everyone plays everyone, so there is no draw luck.{% endif %}
        {% if played %}
          {% set champion = event.entries|filter(e => (e.result.win ?? 0) == 1)|first %}
          {% if champion %}<strong class="font-semibold">Won by {{ champion.players|map(p => p.name)|join(' / ') }}</strong>, with a {{ m.pct(champion.actual.win) }} chance before.{% endif %}
        {% endif %}
      </p>

      {# The rounds of this event: out of the group, each knockout round reached, winning #}
      {% set max = event.maxRounds ?? null %}
      {% set roundNames = { 0: 'the final', 1: 'the semi-finals', 2: 'the quarter-finals', 3: 'the last 16', 4: 'the last 32', 5: 'the last 64', 6: 'the last 128' } %}
      {% set steps = [] %}
      {% set short = [] %}
      {% if event.knockout and max %}
        {% set levels = max - (event.groups is not empty ? 1 : 0) - 1 %}
        {% if event.groups is not empty %}{% set steps = steps|merge(['getting out of the group']) %}{% set short = short|merge(['knockout']) %}{% endif %}
        {% if levels > 0 %}{% for level in (levels - 1)..0 %}
          {% set name = roundNames[level] ?? ('round ' ~ (levels - level)) %}
          {% set steps = steps|merge(['reaching ' ~ name]) %}{% set short = short|merge([name|replace({ 'the ': '' })]) %}
        {% endfor %}{% endif %}
        {% set steps = steps|merge(['winning the final']) %}{% set short = short|merge(['won']) %}
      {% endif %}
      <dl class="grid gap-2 md:grid-cols-[auto_1fr] md:gap-x-6 mb-6 max-w-4xl text-gray-700">
        {% if event.groups is not empty and event.knockout %}
          <dt class="font-semibold">Out of group</dt>
          <dd>The chance of finishing high enough in the group to reach the knockout{{ (event.advance.ranks ?? [1]) == [1] and (event.advance.best ?? []) is empty ? ', which here means winning it' : '' }}.</dd>
        {% endif %}
        <dt class="font-semibold">Wins event</dt>
        <dd>The chance of winning the whole event{{ event.knockout ? ' (the final)' : ' (the group)' }}.</dd>
        {% if single %}
          <dt class="font-semibold">Wins</dt>
          <dd>The matches the player is expected to win in the group, out of {{ max }}.</dd>
        {% elseif placement %}
          <dt class="font-semibold">Placement</dt>
          <dd>The expected final place, 1 to {{ event.entries|length }}: the final decides 1st and 2nd, the losing semi-finalists share 3rd–4th (3.5 each), the third-placed in the groups play for 5th and 6th and the fourth-placed for 7th and 8th.</dd>
        {% else %}
          <dt class="font-semibold">Rounds</dt>
          <dd>
            How many rounds the player is expected to get through, out of {{ max }}: {{ steps|join(', ') }}.
            A bye counts as a round got through, so a player with a bye starts one round ahead.
          </dd>
        {% endif %}
        {% if not single %}
          <dt class="font-semibold">Luck</dt>
          <dd>
            {{ placement ? 'The placement with a fair draw minus with the actual draw' : 'Rounds with the actual draw minus with a fair draw' }} (in brackets in each column): above zero, the draw helps; below, it hurts.
            {% if event.entries|filter(e => e.withdrew ?? false) is not empty %}
              Players who withdrew (lost by walkover) count too: the numbers are with them out from then on, against a fair draw with the same withdrawals. A * marks luck that withdrawals changed (hover for the split).
            {% endif %}
          </dd>
        {% endif %}
        {% if played %}
          <dt class="font-semibold">Result</dt>
          <dd>{{ single ? 'Matches won, and who won the group' : (placement ? 'The final place' : 'How far the player got') }}, and against the expectation with the actual draw (once any withdrawn players were out).</dd>
        {% endif %}
      </dl>

      {% if event.groups|length > 1 %}
        {% set toughest = event.groups|sort((a, b) => b.rating <=> a.rating)|slice(0, 3) %}
        <p class="text-sm text-gray-600 mb-4">
          Strongest groups by average rating:
          {% for g in toughest %}group {{ g.number }} ({{ g.rating }}){{ not loop.last ? ', ' }}{% endfor %}.
        </p>
      {% endif %}

      {% set maxLuck = single ? 1 : max(event.entries|map(e => (e.luck.score ?? e.luck.progress)|abs)|merge([0.01])) %}
      {# Table order: luckiest first (single groups: most likely winner first), by group (each
         group with its players by rating), or by rating when there are no groups #}
      {% set grouped = event.groups|length > 1 %}
      {% set orders = { default: single ? 'Most likely winner first' : 'Luckiest first' }|merge(grouped ? { group: 'By group' } : { rating: 'By rating' })|merge(played ? { standings: 'Final standings' } : {}) %}
      {% set order = craft.app.request.getQueryParam('order') %}
      {% set order = order in orders|keys and order != 'default' ? order : 'default' %}
      <nav class="flex flex-wrap gap-2 mb-4" aria-label="Order">
        {% for key, label in orders %}
          <a href="{{ url('elo/tournaments/' ~ t.cup2000Id, { event: eventIndex }|merge(key != 'default' ? { order: key } : {})) }}"
             class="px-3 py-1 text-sm border border-black transition-colors duration-200 {{ order == key ? 'bg-black text-white' : 'hover:bg-black hover:text-white' }}"
             {% if order == key %}aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
      {% set groupColumn = grouped and order != 'group' %}
      {% set numbered = order == 'standings' %}
      {% set columns = (numbered ? 1 : 0) + 4 + (groupColumn ? 1 : 0) + (event.groups is not empty and event.knockout ? 1 : 0) + (single ? 0 : 1) + (played ? 1 : 0) %}
      <div class="bg-white overflow-x-auto">
        <table class="w-full text-left">
          <thead class="text-sm text-gray-600 border-b border-gray-200">
            <tr>
              {% if numbered %}<th scope="col" class="py-2 pl-4 pr-0 font-normal text-right">#</th>{% endif %}
              <th scope="col" class="py-2 px-4 font-normal">{{ event.pool in ['men', 'women'] ? 'Player' : 'Pair' }}</th>
              {% if groupColumn %}<th scope="col" class="py-2 px-4 font-normal text-right">Group</th>{% endif %}
              <th scope="col" class="py-2 px-4 font-normal text-right" title="Sum of the players' ratings in doubles">Rating</th>
              {% if event.groups is not empty and event.knockout %}<th scope="col" class="py-2 px-4 font-normal text-right" title="Chance of reaching the knockout from the group: actual draw (fair draw)">Out of group</th>{% endif %}
              <th scope="col" class="py-2 px-4 font-normal text-right" title="Chance of winning the event{{ single ? '' : ': actual draw (fair draw)' }}">Wins event</th>
              {% if single %}
                <th scope="col" class="py-2 px-4 font-normal text-right" title="Expected match wins">Wins <span class="whitespace-nowrap">of {{ max }}</span></th>
              {% elseif placement %}
                <th scope="col" class="py-2 px-4 font-normal text-right" title="Expected final place: actual draw (fair draw)">Placement <span class="whitespace-nowrap">of {{ event.entries|length }}</span></th>
              {% else %}
                <th scope="col" class="py-2 px-4 font-normal text-right" title="Rounds expected: actual draw (fair draw)">Rounds{% if max %} <span class="whitespace-nowrap">of {{ max }}</span>{% endif %}</th>
              {% endif %}
              {% if not single %}<th scope="col" class="py-2 px-4 font-normal">Luck</th>{% endif %}
              {% if played %}<th scope="col" class="py-2 px-4 font-normal text-right">Result</th>{% endif %}
            </tr>
          </thead>
          <tbody>
            {% if order == 'group' %}
              {# A header row per group (in number order), then its players by rating; players who
                 start in the knockout last #}
              {% set rows = [] %}
              {% for g in event.groups|sort((a, b) => a.number <=> b.number) %}
                {% set rows = rows|merge([{ header: 'Group ' ~ g.number, detail: 'average rating ' ~ g.rating }])|merge(g.entries|map(i => event.entries[i])|sort((a, b) => b.rating <=> a.rating)) %}
              {% endfor %}
              {% set rest = event.entries|filter(e => e.group is null) %}
              {% if rest is not empty %}{% set rows = rows|merge([{ header: 'Straight to the knockout', detail: '' }])|merge(rest|sort((a, b) => b.rating <=> a.rating)) %}{% endif %}
            {% elseif order == 'standings' %}
              {# How they finished: the winner first, then by place (X classes), or by how far they
                 got and their group place, ties by rating #}
              {% set rows = placement
                ? event.entries|sort((a, b) => (a.result.place <=> b.result.place) ?: (b.rating <=> a.rating))
                : event.entries|sort((a, b) => (b.result.win <=> a.result.win) ?: (b.result.progress <=> a.result.progress) ?: ((a.result.groupRank ?? 99) <=> (b.result.groupRank ?? 99)) ?: (b.rating <=> a.rating)) %}
            {% elseif order == 'rating' %}
              {% set rows = event.entries|sort((a, b) => b.rating <=> a.rating) %}
            {% else %}
              {% set rows = single ? event.entries|sort((a, b) => b.actual.win <=> a.actual.win) : event.entries|sort((a, b) => (b.luck.score ?? b.luck.progress) <=> (a.luck.score ?? a.luck.progress)) %}
            {% endif %}
            {# Final standings: places shared by those who went out at the same stage (the same round,
               or the same group place for those out in the groups; in X classes the same place) #}
            {% set place = 0 %}
            {% set previous = null %}
            {% for e in rows %}
              {% if numbered %}
                {% set key = placement ? e.result.place|round(0, 'floor')
                  : (single ? e.result.groupRank : e.result.win ~ '|' ~ e.result.progress ~ '|' ~ (e.result.progress < 1 ? (e.result.groupRank ?? 0) : 0)) %}
                {% if key != previous %}{% set place = loop.index %}{% endif %}
                {% set previous = key %}
              {% endif %}
              {% if e.header is defined %}
                <tr class="bg-gray-50 border-b border-gray-200">
                  <th scope="colgroup" colspan="{{ columns }}" class="py-2 px-4 text-left font-semibold">{{ e.header }} {% if e.detail %}<span class="font-normal text-sm text-gray-600">· {{ e.detail }}</span>{% endif %}</th>
                </tr>
              {% else %}
              {# Played events with withdrawals: the chances once the withdrawn players were out #}
              {% set ex = e.after ?? e.actual %}
              {% set fx = e.fairAfter ?? e.fair %}
              <tr class="border-b border-gray-100 last:border-0 align-top">
                {% if numbered %}<td class="py-2 pl-4 pr-0 text-right tabular-nums font-semibold">{{ place }}</td>{% endif %}
                <td class="py-2 px-4">
                  {{ m.entry(e, clubEntries) }}
                  {% if e.withdrew ?? false %}<span class="inline-block mt-1 text-xs px-1.5 py-0.5 border border-red-700 text-red-700 rounded">Withdrew</span>{% endif %}
                  {# Played, in the group view: the group places that count, the ones going through
                     (the winner, or the top two), and in the X classes all four (each plays for
                     its places) #}
                  {% set rank = (e.result.groupRank ?? null) %}
                  {% set marked = placement ? [1, 2, 3, 4] : (event.advance.ranks ?? [1]) %}
                  {% if order == 'group' and played and rank and rank in marked %}
                    {% set rankLabels = { 1: 'Won the group', 2: '2nd in the group', 3: '3rd in the group', 4: '4th in the group' } %}
                    <span class="inline-block mt-1 text-xs px-1.5 py-0.5 border rounded {{ rank == 1 ? 'border-green-700 text-green-700' : 'border-gray-500 text-gray-700' }}">{{ rankLabels[rank] ?? (rank ~ '. in the group') }}</span>
                  {% endif %}
                </td>
                {% if groupColumn %}<td class="py-2 px-4 text-right tabular-nums">{{ e.group ?? '–' }}</td>{% endif %}
                <td class="py-2 px-4 text-right tabular-nums">{{ e.rating }}</td>
                {% if event.groups is not empty and event.knockout %}
                  <td class="py-2 px-4 text-right tabular-nums whitespace-nowrap">{{ m.pct(ex.knockout) }} <span class="block text-sm text-gray-500">({{ m.pct(fx.knockout) }})</span></td>
                {% endif %}
                <td class="py-2 px-4 text-right tabular-nums whitespace-nowrap">{{ m.pct(ex.win) }}{% if not single %} <span class="block text-sm text-gray-500">({{ m.pct(fx.win) }})</span>{% endif %}</td>
                {% if single %}
                  <td class="py-2 px-4 text-right tabular-nums">{{ ex.wins|number_format(2) }}</td>
                {% elseif placement %}
                  <td class="py-2 px-4 text-right tabular-nums whitespace-nowrap">{{ ex.place|number_format(2) }} <span class="block text-sm text-gray-500">({{ fx.place|number_format(2) }})</span>
                  </td>
                {% else %}
                  <td class="py-2 px-4 text-right tabular-nums whitespace-nowrap">{{ ex.progress|number_format(2) }} <span class="block text-sm text-gray-500">({{ fx.progress|number_format(2) }})</span>
                  </td>
                {% endif %}
                {% if not single %}
                  {% set luck = (e.luck.score ?? e.luck.progress) %}
                  <td class="py-2 px-4 min-w-40">
                    <span class="tabular-nums font-semibold {{ luck >= 0 ? 'text-green-700' : 'text-red-700' }}"{% if (e.luck.withdrawals ?? 0)|abs >= 0.01 %} title="Draw {{ m.signed(e.luck.draw) }}, withdrawals {{ m.signed(e.luck.withdrawals) }}"{% endif %}>{{ m.signed(luck) }}{% if (e.luck.withdrawals ?? 0)|abs >= 0.01 %}<span class="text-gray-500">*</span>{% endif %}</span>
                    {# Diverging bar from the middle: right for a lucky draw, left for an unlucky one #}
                    <span class="mt-1 flex h-2" aria-hidden="true">
                      <span class="w-1/2 flex justify-end">{% if luck < 0 %}<span class="h-2 rounded-l bg-red-600" style="width: {{ (luck|abs / maxLuck * 100)|round(1) }}%"></span>{% endif %}</span>
                      <span class="w-px bg-gray-400"></span>
                      <span class="w-1/2">{% if luck > 0 %}<span class="block h-2 rounded-r bg-green-600" style="width: {{ (luck / maxLuck * 100)|round(1) }}%"></span>{% endif %}</span>
                    </span>
                  </td>
                {% endif %}
                {% if played %}
                  {% set r = e.result %}
                  <td class="py-2 px-4 text-right tabular-nums whitespace-nowrap">
                    {% if single %}
                      <span class="{{ r.win ? 'font-semibold' : '' }}">{{ r.win ? 'Won' : r.wins|round ~ (r.wins|round == 1 ? ' win' : ' wins') }}</span>
                      <span class="block text-sm {{ r.wins >= ex.wins ? 'text-green-700' : 'text-red-700' }}">{{ m.signed(r.wins - ex.wins, 1) }} wins</span>
                    {% elseif placement %}
                      <span class="{{ r.place == 1 ? 'font-semibold' : '' }}">{{ m.place(r.place) }}</span>
                      {% set diff = ex.place - r.place %}
                      <span class="block text-sm {{ diff >= 0 ? 'text-green-700' : 'text-red-700' }}">{{ m.signed(diff, 1) }} places</span>
                    {% else %}
                      {% set got = r.progress|round %}
                      <span class="{{ r.win ? 'font-semibold' : '' }}">{{ got == 0 ? (event.groups is not empty ? 'group' : 'first match') : (short[got - 1] ?? got) }}</span>
                      {% set expected = ex.progress %}
                      <span class="block text-sm {{ r.progress >= expected ? 'text-green-700' : 'text-red-700' }}">{{ m.signed(r.progress - expected, 1) }} rounds</span>
                    {% endif %}
                  </td>
                {% endif %}
              </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {% endif %}
{% endblock %}
