{# How a club's strength in a pool is calculated, as a sentence fragment. Expects `rule` (craft.elo.clubStrengthRule(pool)). #}
{%- set weights = rule.weights|map(w => (w * 100)|round ~ '%')|join(' · ') -%}
{%- set pairs = rule.pairs ?? null -%}
{%- if pairs == 'mixed' -%}
  a weighted average of the club's best {{ rule.slots }} pairs, its best man with its best woman, its second best man with its second best woman and so on ({{ weights }}, best first)
{%- elseif pairs == 'doubles' -%}
  a weighted average of the club's best {{ rule.slots }} pairs: its two best players, the next two and so on ({{ weights }}, best first)
{%- else -%}
  a weighted average of the club's best {{ rule.slots }} players ({{ weights }}, best first)
{%- endif -%}
