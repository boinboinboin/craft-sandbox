{% extends "_base.twig" %}

{# One player's ratings and rating history. `playerId` comes from the route in config/routes.php. #}

{% set player = craft.elo.player(playerId) %}
{% if not player %}
  {% exit 404 %}
{% endif %}

{% block body %}
  <section class="base-section">
    <div class="base-container px-4">
      <a href="{{ url('elo') }}" class="text-gray-600 hover:text-black">&larr; Rankings</a>
      <h1 class="h1 mt-4">{{ player.name }}</h1>
      {% if player.club %}
        {% set clubEntry = craft.entries.section('clubs').title(player.club).with(['clubLogo']).one() %}
        {% set logo = clubEntry ? clubEntry.clubLogo|first : null %}
        <p class="flex items-center gap-3 text-2xl text-gray-700">
          {% if logo %}<img src="{{ logo.url }}" alt="" class="w-10 h-10 object-contain shrink-0">{% endif %}
          {% if clubEntry %}
            <a href="{{ clubEntry.url }}" class="hover:text-blue-600">{{ player.club }}</a>
          {% else %}
            {{ player.club }}
          {% endif %}
        </p>
      {% endif %}
      <p class="mt-4"><a href="{{ url('elo/head-to-head', { a: player.id }) }}" class="underline hover:text-blue-600">Compare head to head with another player &rarr;</a></p>
    </div>
  </section>

  {# Rating and ranking of all disciplines together, from the history files (seasons are precomputed by rate.mjs) #}
  {% set ratingSeries = [] %}
  {% set rankSeries = [] %}
  {% set seasonRows = {} %}
  {% for handle, p in player.pools %}
    {% set h = p.history %}
    {# slot: fixed colour per discipline, in the order of craft.elo.pools() as on the club pages #}
    {% set slot = craft.elo.pools()|keys|indexOf(handle) %}
    {% if h and h.ratings|length > 1 %}
      {% set ratingSeries = ratingSeries|merge([{ handle: handle, label: p.label, from: h.from, values: h.ratings, slot: slot }]) %}
    {% endif %}
    {% if h and (h.ranks ?? [])|filter(r => r is not null) is not empty %}
      {% set among = handle == 'mixedDoubles' ? (p.gender == 'K' ? ' (among women)' : ' (among men)') : '' %}
      {% set rankSeries = rankSeries|merge([{ handle: handle, label: p.label ~ among, from: h.from, values: h.ranks, counts: h.rankCounts ?? [], slot: slot }]) %}
    {% endif %}
    {% for row in h.seasons ?? [] %}
      {% set key = 's' ~ row.season %}
      {% set seasonRows = seasonRows|merge({ (key): (seasonRows[key] ?? { season: row.season, label: row.season ~ '/' ~ (row.season + 1) })|merge({ (handle): row }) }) %}
    {% endfor %}
  {% endfor %}
  {% set seasonRows = seasonRows|sort((a, b) => a.season <=> b.season) %}

  {% if ratingSeries|length > 1 or rankSeries is not empty %}
    <section class="base-section">
      <div class="base-container px-4 grid gap-6">
        {% if ratingSeries|length > 1 %}
          <div class="bg-white p-4 md:p-6">
            <h2 class="text-xl mb-1">Rating history</h2>
            <p class="text-sm text-gray-600 mb-4">
              Rating in each discipline at the end of each week. Doubles ratings spread over a narrower range than singles,
              so compare how each line moves rather than the levels between singles and doubles.
            </p>
            <div class="relative h-80" data-controller="discipline-chart" data-discipline-chart-label-value="Rating"
                 data-discipline-chart-series-value="{{ ratingSeries|json_encode }}"></div>
            <details class="mt-4">
              <summary class="cursor-pointer text-gray-700 hover:text-black">Rating by season</summary>
              <div class="overflow-x-auto">
                <table class="mt-2 text-left">
                  <thead class="text-sm text-gray-600">
                    <tr>
                      <th scope="col" class="py-1 pr-6 font-normal">Season</th>
                      {% for column in ratingSeries %}<th scope="col" class="py-1 pr-6 font-normal text-right">{{ column.label }}</th>{% endfor %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for row in seasonRows %}
                      <tr>
                        <td class="py-1 pr-6">{{ row.label }}</td>
                        {% for column in ratingSeries %}<td class="py-1 pr-6 text-right tabular-nums">{{ row[column.handle].rating ?? '–' }}</td>{% endfor %}
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <p class="text-sm text-gray-600 mt-2">Rating at the end of each season (or the latest week for the current one).</p>
            </details>
          </div>
        {% endif %}

        {% if rankSeries is not empty %}
          <div class="bg-white p-4 md:p-6">
            <h2 class="text-xl mb-1">Ranking history</h2>
            <p class="text-sm text-gray-600 mb-4">
              National rank at the end of each week, among players who had played in the last 12 months; mixed doubles ranks men and women separately.
              Gaps are periods without a rank. The scale is logarithmic, so moving from #100 to #50 looks as big as from #20 to #10.
            </p>
            <div class="relative h-80" data-controller="discipline-chart" data-discipline-chart-label-value="Rank" data-discipline-chart-rank-value="true"
                 data-discipline-chart-series-value="{{ rankSeries|json_encode }}"></div>
            <details class="mt-4">
              <summary class="cursor-pointer text-gray-700 hover:text-black">Rank by season</summary>
              <div class="overflow-x-auto">
                <table class="mt-2 text-left">
                  <thead class="text-sm text-gray-600">
                    <tr>
                      <th scope="col" class="py-1 pr-6 font-normal">Season</th>
                      {% for column in rankSeries %}<th scope="col" class="py-1 pr-6 font-normal text-right">{{ column.label }}</th>{% endfor %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for row in seasonRows %}
                      <tr>
                        <td class="py-1 pr-6">{{ row.label }}</td>
                        {% for column in rankSeries %}
                          {% set cell = row[column.handle] ?? null %}
                          <td class="py-1 pr-6 text-right tabular-nums whitespace-nowrap">{{ cell and cell.rank ? '#' ~ cell.rank ~ (cell.ranked ? ' of ' ~ cell.ranked|number : '') : '–' }}</td>
                        {% endfor %}
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <p class="text-sm text-gray-600 mt-2">Rank at the end of each season (or the latest week for the current one).</p>
            </details>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {# One tab per discipline (no tabs for players with a single discipline) #}
  {% set tabbed = player.pools|length > 1 %}
  <section class="base-section" {% if tabbed %}data-controller="tabs"{% endif %}>
    <div class="base-container px-4">
      {% if tabbed %}
        <div role="tablist" aria-label="Disciplines" class="flex flex-wrap gap-2 mb-8">
          {% for handle, p in player.pools %}
            <button type="button" role="tab" id="tab-{{ handle }}" aria-controls="{{ handle }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? 0 : -1 }}"
                    data-tabs-target="tab" data-action="tabs#choose keydown->tabs#key"
                    class="px-4 py-2 border border-black transition-colors duration-200 hover:bg-black hover:text-white aria-selected:bg-black aria-selected:text-white cursor-pointer">{{ p.label }}</button>
          {% endfor %}
        </div>
      {% endif %}

  {% for handle, p in player.pools %}
      <div id="{{ handle }}" {% if tabbed %}role="tabpanel" aria-labelledby="tab-{{ handle }}" data-tabs-target="panel" {% if not loop.first %}hidden{% endif %}{% endif %}>
        <h2 class="text-3xl mb-6">{{ p.label }}</h2>

        <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-white p-4">
            <dt class="text-sm text-gray-600">Rating</dt>
            <dd class="text-3xl font-semibold">{{ p.rating|round }} <span class="text-base font-normal text-gray-500" title="95% range">±{{ p.plusMinus }}</span></dd>
          </div>
          <div class="bg-white p-4">
            <dt class="text-sm text-gray-600">Rank</dt>
            {% if p.rank %}
              {% set mixed = handle == 'mixedDoubles' %}
              <dd class="text-3xl font-semibold"><a href="{{ url('elo', { pool: handle }|merge(mixed ? { gender: p.gender } : {})) }}" class="hover:text-blue-600">#{{ p.rank }}</a></dd>
              {% if mixed %}<dd class="text-sm text-gray-600">among {{ p.gender == 'K' ? 'women' : 'men' }}</dd>{% endif %}
            {% else %}
              <dd class="text-xl pt-2">Not ranked <span class="block text-sm text-gray-600">No matches in the last 12 months</span></dd>
            {% endif %}
          </div>
          <div class="bg-white p-4">
            <dt class="text-sm text-gray-600">Peak</dt>
            <dd class="text-3xl font-semibold">{{ p.peak|round }}</dd>
          </div>
          <div class="bg-white p-4">
            <dt class="text-sm text-gray-600">Matches</dt>
            <dd class="text-3xl font-semibold">{{ p.matches|number }}</dd>
            <dd class="text-sm text-gray-600">{{ p.wins }} won · {% if p.draws %}{{ p.draws }} drawn · {% endif %}{{ p.losses }} lost</dd>
          </div>
        </dl>

        {% set history = p.history %}
        {% if history and history.ratings|length > 1 %}
          <div class="bg-white p-4 md:p-6">
            <h3 class="text-xl mb-1">Rating history</h3>
            <p class="text-sm text-gray-600 mb-4">Rating at the end of each week, {{ p.firstPlayed|date('F Y') }} to {{ p.lastPlayed|date('F Y') }}</p>
            <div class="relative h-72"
                 data-controller="rating-chart"
                 data-rating-chart-from-value="{{ history.from }}"
                 data-rating-chart-ratings-value="{{ history.ratings|json_encode }}"
                 data-rating-chart-clubs-value="{{ (history.clubs ?? [])|json_encode }}"></div>

            {# Table view of the chart: rating at the end of each season (July to June), precomputed by rate.mjs #}
            <details class="mt-4">
              <summary class="cursor-pointer text-gray-700 hover:text-black">Rating by season</summary>
              <table class="mt-2 text-left">
                <thead class="text-sm text-gray-600">
                  <tr><th scope="col" class="py-1 pr-8 font-normal">Season</th><th scope="col" class="py-1 pr-8 font-normal">Club</th><th scope="col" class="py-1 font-normal text-right">Rating at end</th></tr>
                </thead>
                <tbody>
                  {% for s in history.seasons ?? [] %}
                    <tr><td class="py-1 pr-8">{{ s.season }}/{{ s.season + 1 }}</td><td class="py-1 pr-8">{{ s.club }}</td><td class="py-1 text-right tabular-nums">{{ s.rating }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </details>
          </div>
        {% endif %}

        {% set matches = p.matchLog %}
        {% if matches and (matches.all ?? []) is not empty %}
          <div class="grid gap-6 mt-6">
            {% if matches.rivals is not empty %}
              {% set rival = matches.rivals|first %}
              <div class="bg-white p-4 md:p-6">
                <h3 class="text-xl mb-1">Biggest rival</h3>
                <p class="text-sm text-gray-600 mb-4">The opponent with the closest matches, from at least 3 meetings</p>
                <p class="text-2xl">
                  <a href="{{ url('elo/players/' ~ rival.opponent.id) }}" class="hover:text-blue-600">{{ rival.opponent.name }}</a>
                  <span class="text-base text-gray-500 tabular-nums">{{ rival.opponent.rating }}</span>
                </p>
                <p class="text-gray-700 mt-1">
                  {{ rival.matches }} matches: {{ rival.wins }} won{% if rival.draws %}, {{ rival.draws }} drawn{% endif %}, {{ rival.losses }} lost ·
                  average margin {{ (rival.margin * 100)|round(1) }}% of points · last met {{ rival.lastPlayed|date('j M Y') }} ·
                  <a href="{{ url('elo/head-to-head', { a: player.id, b: rival.opponent.id }) }}" class="underline hover:text-blue-600">head to head</a>
                </p>
                {% if matches.rivals|length > 1 %}
                  <p class="text-sm text-gray-600 mt-4">Also close:</p>
                  <ul class="mt-1">
                    {% for r in matches.rivals|slice(1) %}
                      <li>
                        <a href="{{ url('elo/players/' ~ r.opponent.id) }}" class="hover:text-blue-600">{{ r.opponent.name }}</a>
                        <span class="text-sm text-gray-600">{{ r.matches }} matches, {{ r.wins }}–{{ r.losses }}{% if r.draws %}–{{ r.draws }}{% endif %}, margin {{ (r.margin * 100)|round(1) }}% ·
                          <a href="{{ url('elo/head-to-head', { a: player.id, b: r.opponent.id }) }}" class="underline hover:text-blue-600">head to head</a></span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
            {% include '_elo/_matches' with { title: 'Matches', matches: matches.all, limit: 20 } only %}
            {# Biggest wins and losses (by win chance) and biggest rating gains and losses, as tabs in one box #}
            {% set highlights = [
              { key: 'wins', label: 'Biggest wins', subtitle: 'Wins with the lowest chance of winning before the match', matches: matches.biggestWins ?? [] },
              { key: 'losses', label: 'Biggest losses', subtitle: 'Losses with the highest chance of winning before the match', matches: matches.biggestLosses ?? [] },
              { key: 'gains', label: 'Biggest rating gains', subtitle: 'The matches that raised the rating most', matches: matches.biggestGains ?? [] },
              { key: 'drops', label: 'Biggest rating losses', subtitle: 'The matches that lowered the rating most', matches: matches.biggestDrops ?? [] },
            ]|filter(h => h.matches is not empty) %}
            {% if highlights is not empty %}
              <div class="bg-white p-4 md:p-6" data-controller="tabs" data-tabs-hash-value="false">
                <h3 class="text-xl mb-3">Highlights</h3>
                <div role="tablist" aria-label="Highlights" class="flex flex-wrap gap-1 mb-4 text-sm">
                  {% for h in highlights %}
                    <button type="button" role="tab" id="tab-{{ handle }}-{{ h.key }}" aria-controls="{{ handle }}-{{ h.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? 0 : -1 }}"
                            data-tabs-target="tab" data-action="tabs#choose keydown->tabs#key"
                            class="px-3 py-1 border border-black transition-colors duration-200 hover:bg-black hover:text-white aria-selected:bg-black aria-selected:text-white cursor-pointer">{{ h.label }}</button>
                  {% endfor %}
                </div>
                {% for h in highlights %}
                  <div id="{{ handle }}-{{ h.key }}" role="tabpanel" aria-labelledby="tab-{{ handle }}-{{ h.key }}" data-tabs-target="panel" {% if not loop.first %}hidden{% endif %}>
                    {% include '_elo/_matches' with { title: h.label, subtitle: h.subtitle, matches: h.matches, embedded: true } only %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
  {% endfor %}
    </div>
  </section>
{% endblock %}
