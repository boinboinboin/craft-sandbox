{% import "_macros/image.twig" as imageMacro %}
<div class="col-span-12 sm:col-span-6 md:col-span-4">
  <div class="bg-white shadow-md rounded-lg overflow-hidden h-full">
    {{ imageMacro.srcset(vinyl.vinylCoverImage.one(), { width: 600, height: 600, class: 'w-full rounded-t-lg h-64 aspect-square object-cover' }) }}
    <div class="p-6">
      <h3 class="text-xl font-semibold mb-2">{{ vinyl.title }}</h3>
      <p class="text-gray-700 mb-4">{{ vinyl.vinylArtist }}</p>
      <a href="{{ vinyl.url }}" class="btn">View</a>
    </div>
  </div>
</div>
