{#
  One upcoming birthday. Vars: person (Entry), daysLeft (int), age (int),
  failed (Entry|null — a failed edit of this person reopens the form with its errors), redirect
#}
{% set editFailed = failed and failed.id == person.id %}
<li class="py-6 border-b border-gray-200" data-controller="toggle">
  <div class="flex items-start justify-between gap-6">
    <div class="min-w-0">
      <h3 class="text-2xl">{{ person.title }}</h3>
      <p class="text-gray-700">{{ person.birthDate|date('j F') }} · turns {{ age }}</p>
      {% if person.giftIdeas %}
        <p class="mt-2 text-gray-500">{{ person.giftIdeas|nl2br }}</p>
      {% endif %}
    </div>
    <div class="flex shrink-0 flex-col items-end gap-3">
      <p class="text-right leading-none">
        {% if daysLeft == 0 %}
          <span class="block text-4xl">Today</span>
        {% else %}
          <span class="block text-4xl">{{ daysLeft }}</span>
          <span class="text-sm text-gray-500">{{ daysLeft == 1 ? 'day' : 'days' }}</span>
        {% endif %}
      </p>
      <div class="-mr-1 flex gap-1">
        <button type="button" class="btn-icon" data-action="toggle#toggle" aria-label="Edit" title="Edit">
          {{ svg(include('_svg/icons/edit.svg')) }}
        </button>
        <form method="post" data-controller="confirm" data-confirm-message-value="Remove {{ person.title }}?" data-action="submit->confirm#confirm">
          {{ csrfInput() }}
          {{ actionInput('elements/delete') }}
          {{ hiddenInput('elementId', person.id) }}
          {{ redirectInput(redirect) }}
          <button type="submit" class="btn-icon btn-icon-danger" aria-label="Remove" title="Remove">
            {{ svg(include('_svg/icons/trash.svg')) }}
          </button>
        </form>
      </div>
    </div>
  </div>
  <div class="pt-6" data-toggle-target="content" {{ editFailed ? '' : 'hidden' }}>
    {% include '_includes/birthdayForm.twig' with {
      person: editFailed ? failed : person,
      redirect: redirect,
      submit: 'save',
    } only %}
  </div>
</li>
