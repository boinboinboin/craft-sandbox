{% import "_macros/image.twig" as imageMacro %}

<div class="col-span-12 sm:col-span-6 md:col-span-4">
    <div class="bg-white shadow-md rounded-lg overflow-hidden h-full">
        {{ imageMacro.srcset(image, {
        width: 600,
        height: 400,
        class: 'w-full h-48'
        }) }}
        <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">{{ title }}</h3>
            <p class="text-gray-700 mb-4">{{ text }}</p>
            <a href="{{ url }}" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">{{ "text.read.more"|t }}</a>
        </div>
    </div>
</div>
