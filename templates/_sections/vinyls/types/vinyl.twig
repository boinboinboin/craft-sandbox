{% extends "_base.twig" %}
{% import "_macros/image.twig" as imageMacro %}

{% block body %}
  <section class="base-section">
    <div class="base-container">
      {{ imageMacro.srcset(entry.vinylCoverImage.one(), { width: 600, height: 600, lazyload: false }) }}
      <h1 class="h1">{{ entry.title }}</h1>
      <p class="base">{{ entry.vinylArtist }}</p>
      <p class="base">{{ entry.vinylStatus == 'owned' ? 'Owned' : 'Wanted' }}</p>
    </div>
  </section>
{% endblock %}
