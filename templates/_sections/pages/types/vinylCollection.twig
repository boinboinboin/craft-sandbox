{% extends "_base.twig" %}
{% import "_macros/block.twig" as blockMacro %}

{% block body %}
  {% requireLogin %}

  <section class="base-section">
    <div class="base-container">
      <h1 class="h1">{{ entry.title }}</h1>
      {% if entry.preamble %}<p class="text-2xl">{{ entry.preamble }}</p>{% endif %}
    </div>
  </section>

  <section class="base-section" data-controller="discogs-search">
    <div class="base-container">
      <h2 class="text-3xl mb-4">Add from Discogs</h2>
      <form class="flex items-center gap-2 mb-4 border-b border-gray-300 focus-within:border-black transition-colors" data-action="submit->discogs-search#search">
        <input type="text" data-discogs-search-target="input" placeholder="Search Discogs..." class="flex-1 py-2 bg-transparent outline-none">
        <button type="submit" class="btn-icon" aria-label="Search" title="Search">
          {{ svg(include('_svg/icons/search.svg')) }}
        </button>
      </form>
      <template data-discogs-search-target="wishlistIcon">{{ svg(include('_svg/icons/heart.svg')) }}</template>
      <template data-discogs-search-target="collectionIcon">{{ svg(include('_svg/icons/add.svg')) }}</template>
      <p data-discogs-search-target="status" class="text-gray-700 mb-4"></p>
      <div data-discogs-search-target="results" class="max-h-96 overflow-y-auto"></div>
    </div>
  </section>

  {% set owned = craft.entries().section('vinyls').authorId(currentUser.id).vinylStatus('owned').all() %}
  {% set wanted = craft.entries().section('vinyls').authorId(currentUser.id).vinylStatus('wanted').all() %}

  <section class="base-section">
    <div class="base-container">
    {% if owned|length == 0 %}
      <section class="base-section">
        <div class="base-container">
          <p class="base">No vinyls in your collection yet.</p>
        </div>
      </section>
    {% else %}
      <h2 class="text-5xl mb-10">Collection</h2>
      <div class="base-grid">
        {% for vinyl in owned %}
          {{ blockMacro.include("_cards/vinylCard.twig", entry, { vinyl: vinyl }) }}
        {% endfor %}
      </div>
    {% endif %}
    </div>
  </section>

  <section class="base-section">
    <div class="base-container">
    {% if wanted|length == 0 %}
      <section class="base-section">
        <div class="base-container">
          <p class="base">No vinyls on your wishlist yet.</p>
        </div>
      </section>
    {% else %}
      <h2 class="text-5xl mb-10">Wishlist</h2>
      <div class="base-grid">
        {% for vinyl in wanted %}
          {{ blockMacro.include("_cards/vinylCard.twig", entry, { vinyl: vinyl }) }}
        {% endfor %}
      </div>
    {% endif %}
    </div>
  </section>
{% endblock %}
