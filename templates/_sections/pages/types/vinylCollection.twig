{% extends "_base.twig" %}
{% import "_macros/block.twig" as blockMacro %}

{% block body %}
  <section class="base-section">
    <div class="base-container">
      <h1 class="h1">{{ entry.title }}</h1>
      {% if entry.preamble %}<p class="text-2xl">{{ entry.preamble }}</p>{% endif %}
    </div>
  </section>

  {% set owned = craft.entries().section('vinyls').vinylStatus('owned').all() %}
  {% set wanted = craft.entries().section('vinyls').vinylStatus('wanted').all() %}

  <section class="base-section">
    <div class="base-container">
    {% if owned|length == 0 %}
      <section class="base-section">
        <div class="base-container">
          <p class="base">No owned vinyls found.</p>
        </div>
      </section>
    {% else %}
      <h2 class="text-5xl mb-10">Owned</h2>
      <div class="base-grid">
        {% for vinyl in owned %}
          {{ blockMacro.include("_cards/vinylCard.twig", entry, { vinyl: vinyl }) }}
        {% endfor %}
      </div>
    {% endif %}
    </div>
  </section>

  <section class="base-section">
    <div class="base-container">
    {% if wanted|length == 0 %}
      <section class="base-section">
        <div class="base-container">
          <p class="base">No wanted vinyls found.</p>
        </div>
      </section>
    {% else %}
      <h2 class="text-5xl mb-10">Wanted</h2>
      <div class="base-grid">
        {% for vinyl in wanted %}
          {{ blockMacro.include("_cards/vinylCard.twig", entry, { vinyl: vinyl }) }}
        {% endfor %}
      </div>
    {% endif %}
      
    </div>
  </section>
{% endblock %}
