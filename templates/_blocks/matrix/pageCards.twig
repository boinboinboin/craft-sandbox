{% import "_macros/block.twig" as blockMacro %}
<section class="base-section">
    <div class="base-container">
        <div class="base-grid">
            {% for card in cards %}
                {{ blockMacro.include("_cards/pageCard.twig", entry, {
                    title: card.title,
                    text: card.text | truncate(150, '...'),
                    url: card.url,
                    image: card.image
                }) }}
            {% endfor %}
        </div>
    </div>
</section>
